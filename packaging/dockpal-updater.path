[Unit]
Description=Dockpal updater trigger watcher
# Start watching only after the panel's data directory exists.
ConditionPathIsDirectory=/opt/dockpal

[Path]
# Fire whenever the panel (running as the unprivileged dockpal user) writes a
# system-update request into its writable trigger dir. The panel is installed
# with DOCKPAL_UPDATE_TRIGGER_DIR=/opt/dockpal so the trigger and result files
# land here (its data dir /opt/dockpal/data is a different tree). The helper
# removes the file before acting so this does not re-trigger.
PathExists=/opt/dockpal/update-request.json
Unit=dockpal-updater.service

[Install]
WantedBy=multi-user.target
